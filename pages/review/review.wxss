/* 审核台页（复用全局 hero / card / empty，见 app.wxss） */
.review-card {
  margin: 0 36rpx 28rpx;
}

.review-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.review-name {
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: var(--ink);
}

.review-role {
  margin-left: 14rpx;
  padding: 4rpx 12rpx;
  background: var(--primary);
  color: #F1E6D8;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.review-time {
  font-size: 20rpx;
  color: #9AA0B0;
}

.review-facts {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
}

.fact {
  width: 50%;
  display: flex;
  margin-bottom: 10rpx;
}

.fact-k {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #8A8FA0;
}

.fact-v {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  word-break: break-all;
}

.review-photo-wrap {
  margin-top: 10rpx;
}

.review-photo-label {
  font-size: 22rpx;
  color: #8A8FA0;
  margin-bottom: 10rpx;
}

.review-photo {
  width: 100%;
  height: 420rpx;
  background: var(--primary-tint);
}

.review-photo-missing {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #9AA0B0;
  background: var(--primary-tint);
}

.review-actions {
  margin-top: 22rpx;
  display: flex;
}

.review-btn {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  font-size: 27rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.review-btn.no {
  margin-right: 16rpx;
  background: var(--accent2);
  color: #F1E6D8;
}

.review-btn.yes {
  background: var(--primary);
  color: #F1E6D8;
}

.loading {
  margin: 30rpx 36rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9AA0B0;
}
