/* ============================================================
 * 常见问题页 · 包豪斯海报风格
 * 居中标题区 + 关键词检索 + 编号色块 FAQ，全程无描边无线条
 * ============================================================ */

/* ---------------- 一、居中标题区 ---------------- */
.help-hero {
  position: relative;
  overflow: hidden;
  padding: 54rpx 40rpx 62rpx;
  text-align: center;
  background: linear-gradient(118deg, var(--primary-soft) 0%, var(--primary) 48%, var(--primary-deep) 100%);
}

/* 居中几何徽标：半透明方块 + 橙圆 + 米白三角 */
.hh-badge {
  position: relative;
  z-index: 2;
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 30rpx;
  background: rgba(241, 230, 216, 0.14);
}

.hh-badge-dot {
  position: absolute;
  left: 22rpx;
  top: 22rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: var(--accent3);
}

.hh-badge-tri {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  width: 0;
  height: 0;
  border-left: 13rpx solid transparent;
  border-right: 13rpx solid transparent;
  border-bottom: 22rpx solid rgba(241, 230, 216, 0.9);
}

.hh-kicker {
  position: relative;
  z-index: 2;
  display: inline-block;
  padding: 7rpx 18rpx;
  background: var(--accent3);
  color: #FFFFFF;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.hh-title {
  position: relative;
  z-index: 2;
  margin-top: 22rpx;
  font-size: 58rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 8rpx;
  line-height: 1.2;
  text-align: center;
}

/* 居中的几何短条组：橙 + 米白 + 红点 */
.hh-rule {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}

.hh-rule .rule-a {
  width: 84rpx;
  height: 12rpx;
  background: var(--accent3);
}

.hh-rule .rule-b {
  width: 30rpx;
  height: 12rpx;
  margin-left: 10rpx;
  background: rgba(241, 230, 216, 0.65);
}

.hh-rule .rule-c {
  width: 14rpx;
  height: 14rpx;
  margin-left: 10rpx;
  border-radius: 50%;
  background: var(--accent2);
}

.hh-desc {
  position: relative;
  z-index: 2;
  margin-top: 22rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.84);
  letter-spacing: 1rpx;
}

/* ---------------- 二、关键词检索（白色块面 + 几何标记） ---------------- */
.faq-search {
  margin: 24rpx;
  padding: 26rpx 24rpx 14rpx;
  background: var(--paper);
  border-radius: var(--r-block);
}

.fs-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 20rpx;
  background: var(--accent1);
}

/* 检索框左侧几何标记：主色方块 + 橙点 */
.fs-mark {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  margin-right: 18rpx;
  background: var(--primary);
  flex-shrink: 0;
}

.fs-mark::after {
  content: '';
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--accent3);
}

.fs-input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.fs-clear {
  margin-left: 14rpx;
  padding: 8rpx 18rpx;
  background: var(--accent3);
  color: #FFFFFF;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.ph {
  color: #B4AC9C;
}

/* 关键词快选标签：米白块，选中变主色（点元素） */
.fs-kw {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.kw {
  padding: 8rpx 18rpx;
  margin: 0 12rpx 12rpx 0;
  background: var(--accent1);
  font-size: 22rpx;
  font-weight: 600;
  color: #5A5F70;
  letter-spacing: 0.5rpx;
}

.kw.on {
  background: var(--primary);
  color: #FFFFFF;
}

.kw:active {
  background: var(--accent3);
  color: #FFFFFF;
}

/* ---------------- 三、常见问题（四色循环编号块面） ---------------- */
.faq-list {
  margin: 0 24rpx;
}

.faq-item {
  position: relative;
  padding: 26rpx;
  margin-bottom: 18rpx;
  background: var(--paper);
  border-radius: var(--r-block);
}

.faq-item.open {
  background: var(--accent1-soft);
}

.faq-q {
  display: flex;
  align-items: center;
}

/* 编号块：四色循环（主色 / 辅色2 / 橙 / 墨），点睛第四色 */
.faq-no {
  width: 52rpx;
  height: 52rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: var(--primary);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 52rpx;
  text-align: center;
  letter-spacing: 1rpx;
}

.faq-item:nth-child(4n + 2) .faq-no {
  background: var(--accent2);
}

.faq-item:nth-child(4n + 3) .faq-no {
  background: var(--accent3);
}

.faq-item:nth-child(4n) .faq-no {
  background: var(--ink);
}

.faq-q-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.4;
}

/* 展开标记：横竖两笔构成的正负号 */
.faq-sign {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.faq-sign .sign-h,
.faq-sign .sign-v {
  position: absolute;
  background: var(--ink);
}

.faq-sign .sign-h {
  left: 0;
  right: 0;
  top: 15rpx;
  height: 4rpx;
}

.faq-sign .sign-v {
  top: 0;
  bottom: 0;
  left: 15rpx;
  width: 4rpx;
  transition: transform 0.18s;
}

.faq-item.open .faq-sign .sign-v {
  transform: scaleY(0);
}

.faq-a {
  margin-top: 20rpx;
  margin-left: 72rpx;
  padding: 20rpx 22rpx;
  border-left: 8rpx solid var(--primary);
  background: var(--paper);
  font-size: 25rpx;
  color: #3A4152;
  line-height: 1.7;
}

/* 双端主题下答案条与编号统一换色 */
.theme-mentor .faq-a {
  border-left-color: var(--primary);
}
