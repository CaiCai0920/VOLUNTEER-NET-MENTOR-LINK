/* ---------------- 顶部个人信息（居中式几何构成） ---------------- */
.profile-hero {
  padding-top: 52rpx;
  padding-bottom: 90rpx;
  text-align: center;
}

/* 头像为方形块面，与列表圆形头像形成几何对比 */
.avatar.big {
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto;
  border-radius: 0;
  font-size: 52rpx;
  font-weight: 800;
  background: rgba(241, 230, 216, 0.18);
  color: #FFFFFF;
}

.profile-name {
  position: relative;
  z-index: 2;
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.profile-sub {
  position: relative;
  z-index: 2;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

/* ---------------- 数据块面（白块，无线条） ---------------- */
.stat-row {
  position: relative;
  z-index: 3;
  display: flex;
  margin: -52rpx 24rpx 0;
  padding: 34rpx 0;
  background: var(--paper);
  border-radius: var(--r-block);
}

.stat-card {
  position: relative;
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--primary);
  line-height: 1.2;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8A8494;
  letter-spacing: 1rpx;
}

/* ---------------- 操作列表（点标记 + 留白分隔） ---------------- */
.action-card {
  padding: 10rpx 28rpx;
}

.action-item {
  display: flex;
  align-items: center;
  height: 110rpx;
}

/* 每项前的几何色点：橙 - 主色 - 主色（第四色点睛在首项） */
.action-item::before {
  content: '';
  width: 14rpx;
  height: 14rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: var(--primary);
  flex-shrink: 0;
}

.action-item:nth-child(1)::before {
  background: var(--accent3);
}

.action-text {
  flex: 1;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}

.action-arrow {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1;
}

/* 审核台入口角标：待审核人数 */
.review-badge {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  background: var(--accent2);
  color: #F1E6D8;
  font-size: 19rpx;
  font-weight: 800;
}

/* ---- 顶部返回入口（个人中心非一级入口） ---- */
.back-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx 0;
}

.back-arrow {
  margin-right: 8rpx;
  font-size: 36rpx;
  line-height: 1;
  color: var(--primary);
}

.back-text {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--primary);
}

/* ---- 左右分割布局：左人像拼贴（通高固定），右信息滚动 ---- */
.mine-split-page {
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  display: flex;
  flex-direction: column;
}

.profile-split {
  flex: 1;
  min-height: 0;
  display: flex;
}

.ps-left {
  position: relative;
  width: 41%;
  flex-shrink: 0;
  overflow: hidden;
}

.ps-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.ps-left-veil {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 46%;
  background: linear-gradient(180deg, rgba(20,23,31,0) 0%, rgba(20,23,31,0.28) 55%, rgba(20,23,31,0.62) 100%);
}

.ps-deco {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  right: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ps-no {
  font-family: "DIN Alternate", Consolas, Menlo, monospace;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: rgba(40, 49, 78, 0.65);
}

.ps-hud {
  font-family: "DIN Alternate", Consolas, Menlo, monospace;
  font-size: 17rpx;
  letter-spacing: 2rpx;
  color: rgba(40, 49, 78, 0.5);
}

.ps-id {
  position: absolute;
  left: 64rpx;
  right: 36rpx;
  top: 50%;
  transform: translateY(-50%);
  /* 深藏蓝铭牌底板：与照片背景明确分层（杂志 ID 卡语言） */
  padding: 30rpx 32rpx;
  background: rgba(23, 29, 46, 0.86);
  border: 2rpx solid rgba(241, 230, 216, 0.24);
  box-shadow: 10rpx 10rpx 0 rgba(20, 23, 31, 0.35);
}

.avatar-solid {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: #AA283A;
  color: #F1E6D8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 800;
  box-shadow: 0 6rpx 20rpx rgba(20, 23, 31, 0.35);
}

.ps-name {
  margin-top: 22rpx;
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #F1E6D8;
  white-space: nowrap;
}

.ps-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(241, 230, 216, 0.78);
}

.ps-chip {
  display: inline-block;
  margin-top: 20rpx;
  margin-right: 10rpx;
  padding: 6rpx 14rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
  background: rgba(241, 230, 216, 0.16);
  border: 1rpx solid rgba(241, 230, 216, 0.4);
  color: rgba(241, 230, 216, 0.85);
}

.ps-right {
  flex: 1;
  min-width: 0;
  height: 100%;
  box-sizing: border-box;
}

.ps-right .back-bar {
  padding: 28rpx 28rpx 8rpx;
}

.ps-stats {
  display: flex;
  margin: 16rpx 24rpx 0;
  background: var(--paper);
}

.ps-stat {
  flex: 1;
  padding: 26rpx 4rpx;
  text-align: center;
  border-right: 1rpx solid rgba(40, 49, 78, 0.10);
}

.ps-stat:last-child {
  border-right: none;
}

.ps-num {
  font-family: "DIN Alternate", Consolas, Menlo, monospace;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--primary);
}

.ps-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: rgba(40, 49, 78, 0.55);
}

.ps-right .action-card {
  margin: 20rpx 24rpx 0;
}

.ps-right .notice {
  margin: 20rpx 24rpx 0;
}

.ps-right .footer-tip {
  padding: 24rpx 0 60rpx;
}
