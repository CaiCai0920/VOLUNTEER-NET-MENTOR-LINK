/* ============================================================
 * 社区页：微博式分区条 + 小红书式双列瀑布流 + 悬浮发布按钮
 * ============================================================ */

.page-wrap {
  padding-bottom: 140rpx;
}

/* ---- 双列瀑布流 ---- */
.feed {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 20rpx 0;
}

.feed-col {
  flex: 1;
  min-width: 0;
}

.feed-col:first-child {
  margin-right: 20rpx;
}

/* ---- 帖子卡（纯白块面，无描边无投影）---- */
.post-card {
  background: var(--paper);
  margin-bottom: 20rpx;
  overflow: hidden;
}

.post-cover {
  display: block;
  width: 100%;
  height: 320rpx;
  background: var(--primary-tint);
}

.post-body {
  padding: 20rpx 22rpx 24rpx;
}

/* 话题行：橙色小方块引导 + 主色话题字 */
.post-topic {
  display: flex;
  align-items: center;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: 0.5rpx;
}

.post-topic::before {
  content: '';
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  background: var(--accent3);
  flex-shrink: 0;
}

.post-text {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.55;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}

.post-foot {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.post-foot .avatar.small {
  width: 44rpx;
  height: 44rpx;
  font-size: 20rpx;
}

.post-name {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  font-size: 23rpx;
  color: #3A4152;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-time {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #97919A;
}

/* ---- 悬浮发布按钮 ---- */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(var(--primary-rgb), 0.35);
}

.fab:active {
  background: var(--primary-deep);
}

.fab-plus {
  font-size: 60rpx;
  font-weight: 300;
  color: #FFFFFF;
  line-height: 1;
  margin-top: -6rpx;
}

/* 橙色点睛小圆：按钮右上角 */
.fab-dot {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--accent3);
}
