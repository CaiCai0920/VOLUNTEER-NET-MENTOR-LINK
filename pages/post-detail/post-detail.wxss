.page-wrap {
  min-height: 100vh;
  /* 底部固定评论输入条的高度预留（含安全区），正文末尾不被盖住 */
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

/* 顶部返回条：米白底 + 藏蓝发丝线 */
.detail-top {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid rgba(40, 49, 78, 0.14);
}

.back-btn {
  font-size: 28rpx;
  font-weight: 700;
  color: #28314E;
  padding: 6rpx 18rpx 6rpx 0;
}

.detail-top-tx {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: #14171F;
}

.detail-top-no {
  margin-left: auto;
  font-family: "DIN Alternate", "Consolas", "Menlo", monospace;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: rgba(40, 49, 78, 0.45);
}

/* 媒体轮播 */
.media-swiper {
  width: 100%;
  height: 560rpx;
  background: #14171F;
}

.media-img,
.media-video {
  width: 100%;
  height: 100%;
}

.media-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  font-size: 24rpx;
  color: rgba(241, 230, 216, 0.6);
}

/* 正文卡 */
.detail-card {
  position: relative;
  margin: 24rpx 30rpx;
  padding: 30rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(40, 49, 78, 0.14);
}

.detail-card.qa {
  border: 3rpx solid rgba(170, 40, 58, 0.55);
  box-shadow: 8rpx 8rpx 0 rgba(170, 40, 58, 0.12);
}

.detail-author {
  display: flex;
  align-items: center;
}

.author-main {
  flex: 1;
  margin-left: 18rpx;
}

.author-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #14171F;
}

.author-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: rgba(20, 23, 31, 0.55);
}

.topic-tag {
  padding: 6rpx 18rpx;
  border: 2rpx solid rgba(40, 49, 78, 0.4);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: #28314E;
}

.topic-tag.qa {
  background: #AA283A;
  border-color: #AA283A;
  color: #FFFFFF;
}

.detail-content {
  margin-top: 26rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: #14171F;
  word-break: break-all;
}

/* 认领栏（与社区页同款语言） */
.claim-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
  padding: 18rpx 22rpx;
  background: rgba(170, 40, 58, 0.06);
  border: 2rpx solid rgba(170, 40, 58, 0.28);
}

.claim-tx {
  font-size: 23rpx;
  letter-spacing: 1rpx;
  color: rgba(170, 40, 58, 0.85);
}

.claim-btn {
  padding: 12rpx 34rpx;
  background: #AA283A;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.claim-btn.done {
  background: #FFFFFF;
  color: rgba(40, 49, 78, 0.5);
  border: 2rpx solid rgba(40, 49, 78, 0.25);
}

.claim-note {
  margin-top: 14rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: rgba(20, 23, 31, 0.5);
}

/* 评论区：与正文卡同一白板语言（米白纸面 + 藏蓝发丝边） */
.comment-zone {
  margin: 0 30rpx 24rpx;
  padding: 26rpx 30rpx 30rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(40, 49, 78, 0.14);
}

.cmz-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid rgba(40, 49, 78, 0.1);
}

.cmz-title {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: #14171F;
}

.cmz-count {
  margin-left: 10rpx;
  font-family: "DIN Alternate", "Consolas", "Menlo", monospace;
  font-size: 24rpx;
  color: #AA283A;
}

.cmz-en {
  font-family: "DIN Alternate", "Consolas", "Menlo", monospace;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: rgba(40, 49, 78, 0.45);
}

.comment-item {
  display: flex;
  align-items: flex-start;
  margin-top: 26rpx;
}

.comment-main {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
}

.comment-top {
  display: flex;
  align-items: center;
}

.comment-name {
  font-size: 25rpx;
  font-weight: 700;
  color: #28314E;
}

/* 学长/学姐身份小签：红字提示，与红头像呼应 */
.comment-role {
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  background: rgba(170, 40, 58, 0.08);
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: #AA283A;
}

.comment-text {
  margin-top: 8rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: #14171F;
  word-break: break-all;
}

.comment-time {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(20, 23, 31, 0.45);
}

.comment-empty {
  padding: 40rpx 0 10rpx;
  text-align: center;
}

.comment-empty-tx {
  font-size: 24rpx;
  color: rgba(20, 23, 31, 0.45);
}

/* 底部评论输入条：白底 + 藏蓝发丝顶边，固定悬浮避让安全区 */
.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 2rpx solid rgba(40, 49, 78, 0.14);
}

.comment-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #F1E6D8;
  border: 2rpx solid rgba(40, 49, 78, 0.18);
  font-size: 26rpx;
  color: #14171F;
}

.comment-ph {
  color: rgba(40, 49, 78, 0.4);
}

.comment-send {
  margin-left: 18rpx;
  padding: 0 34rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: rgba(40, 49, 78, 0.25);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

/* 输入框有内容 → 朱红可发态；发送中 → 半透明防连点 */
.comment-send.ok {
  background: #AA283A;
}

.comment-send.busy {
  opacity: 0.55;
}
