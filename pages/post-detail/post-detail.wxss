.page-wrap {
  min-height: 100vh;
}

/* 顶部返回条：米白底 + 藏蓝发丝线 */
.detail-top {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid rgba(40, 49, 78, 0.14);
}

.back-btn {
  font-size: 28rpx;
  font-weight: 700;
  color: #28314E;
  padding: 6rpx 18rpx 6rpx 0;
}

.detail-top-tx {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: #14171F;
}

.detail-top-no {
  margin-left: auto;
  font-family: "DIN Alternate", "Consolas", "Menlo", monospace;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: rgba(40, 49, 78, 0.45);
}

/* 媒体轮播 */
.media-swiper {
  width: 100%;
  height: 560rpx;
  background: #14171F;
}

.media-img,
.media-video {
  width: 100%;
  height: 100%;
}

.media-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  font-size: 24rpx;
  color: rgba(241, 230, 216, 0.6);
}

/* 正文卡 */
.detail-card {
  position: relative;
  margin: 24rpx 30rpx;
  padding: 30rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(40, 49, 78, 0.14);
}

.detail-card.qa {
  border: 3rpx solid rgba(170, 40, 58, 0.55);
  box-shadow: 8rpx 8rpx 0 rgba(170, 40, 58, 0.12);
}

.detail-author {
  display: flex;
  align-items: center;
}

.author-main {
  flex: 1;
  margin-left: 18rpx;
}

.author-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #14171F;
}

.author-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: rgba(20, 23, 31, 0.55);
}

.topic-tag {
  padding: 6rpx 18rpx;
  border: 2rpx solid rgba(40, 49, 78, 0.4);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: #28314E;
}

.topic-tag.qa {
  background: #AA283A;
  border-color: #AA283A;
  color: #FFFFFF;
}

.detail-content {
  margin-top: 26rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: #14171F;
  word-break: break-all;
}

/* 认领栏（与社区页同款语言） */
.claim-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
  padding: 18rpx 22rpx;
  background: rgba(170, 40, 58, 0.06);
  border: 2rpx solid rgba(170, 40, 58, 0.28);
}

.claim-tx {
  font-size: 23rpx;
  letter-spacing: 1rpx;
  color: rgba(170, 40, 58, 0.85);
}

.claim-btn {
  padding: 12rpx 34rpx;
  background: #AA283A;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.claim-btn.done {
  background: #FFFFFF;
  color: rgba(40, 49, 78, 0.5);
  border: 2rpx solid rgba(40, 49, 78, 0.25);
}

.claim-note {
  margin-top: 14rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: rgba(20, 23, 31, 0.5);
}
