/* ============================================================
 * 志愿人脉 · UI 实验副本 —— 全局设计系统 v3「米白底 HUD」
 * ------------------------------------------------------------------
 * 配色：与原版完全一致，一字不改 ——
 *   新生端：主色 藏蓝 #28314E（大面积，hero 整块换色）
 *           底色 米白 #F1E6D8（最大面积）
 *           强调 红   #AA283A
 *           点睛 橙   #F29344
 *   老生端：蓝红对调（大面积切换保留）
 * 点线面规划（参考：构成主义拼贴 + 科幻海报 + 莱茵生命 PV 动效）：
 *   · 面：米白大底 + hero 整块主色（藏蓝/红，双端大面积切换）
 *   · 线：发丝线画在米白与主色块上 —— 同心圆轨 / 十字准星 /
 *         蓝图网格 / 虚线轨道 / 刻度条（米白块上用藏蓝线，色块上用米白线）
 *   · 点：橙 / 红小实块 + 等宽注释小字 + 面板对角括弧角标
 * 动效：hero 扫描线缓扫 / 圆轨慢旋 / 标记呼吸闪烁
 * 本文件保留 v1 全部类名，页面文件零改动换肤。
 * ============================================================ */

page {
  /* ---- 主色（新生端：藏蓝）---- */
  --primary: #28314E;
  --primary-deep: #171D2E;
  --primary-soft: #3D4A70;
  --primary-rgb: 40, 49, 78;
  --primary-tint: #E2E6F0;

  /* ---- 底色：米白（最大面积）---- */
  --accent1: #F1E6D8;
  --accent1-soft: #F7EFE3;

  /* ---- 强调：红 ---- */
  --accent2: #AA283A;
  --accent2-rgb: 170, 40, 58;
  --accent2-tint: #F3E3E6;
  --accent2-soft: #C23A4E;
  --accent2-deep: #8E1F30;

  /* ---- 点睛：橙 ---- */
  --accent3: #F29344;
  --accent3-tint: #FBE9D8;

  /* ---- 中性：与 v1 一致 ---- */
  --ink: #14171F;
  --paper: #FFFFFF;
  --r-block: 0rpx;              /* 全直角：HUD 不做圆角 */

  background: var(--accent1);
  color: var(--ink);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  line-height: 1.55;
}

/* ---- 老生端：蓝红对调（大面积切换保留）---- */
.theme-mentor {
  --primary: #AA283A;
  --primary-deep: #6E1723;
  --primary-soft: #C24856;
  --primary-rgb: 170, 40, 58;
  --primary-tint: #F2DFE2;

  --accent2: #28314E;
  --accent2-rgb: 40, 49, 78;
  --accent2-tint: #E2E6F0;
  --accent2-soft: #4A5678;
  --accent2-deep: #171D2E;
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

/* ============================================================
 * 一、点线面元件（hero 主色块上的米白 HUD 线条组）
 * ============================================================ */

/* 蓝图网格：铺在 hero 主色块右上，坐标纸质感 */
.hero-grid {
  position: absolute;
  top: 0;
  right: 0;
  width: 560rpx;
  height: 420rpx;
  background-image:
    linear-gradient(rgba(241, 230, 216, 0.09) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(241, 230, 216, 0.09) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
  -webkit-mask-image: linear-gradient(115deg, transparent 8%, #000 70%);
  mask-image: linear-gradient(115deg, transparent 8%, #000 70%);
  pointer-events: none;
}

/* 几何装饰层容器（沿用 v1 挂载点） */
.hero-deco {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
}

/*
 * 右上角 HUD 组合体（沿用 v1 五件套挂载点，重绘为点线面构成）：
 *   橙实条 → 米白描边方块 → 同心圆轨（双环 + 红点）
 *   → 橙实半圆 → 点阵 → 慢旋虚线外轨
 */

/* 实条：橙，右端出血（点睛实块） */
.hd-bar {
  position: absolute;
  right: 0;
  top: 118rpx;
  width: 250rpx;
  height: 6rpx;
  background: var(--accent3);
}

/* 方块：米白描边空心，内嵌橙色微标 */
.hd-square {
  position: absolute;
  right: 168rpx;
  top: 42rpx;
  width: 52rpx;
  height: 52rpx;
  border: 2rpx solid rgba(241, 230, 216, 0.75);
  background: transparent;
}

.hd-square::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  margin: -6rpx 0 0 -6rpx;
  background: var(--accent3);
}

/* 同心圆轨：外环米白实线 + 内环细线 + 红点（参考图 1 的轨道圆） */
.hd-circle {
  position: absolute;
  right: 52rpx;
  top: 62rpx;
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(241, 230, 216, 0.65);
  background: transparent;
}

.hd-circle::before {
  content: '';
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(241, 230, 216, 0.3);
}

.hd-circle::after {
  content: '';
  position: absolute;
  right: 6rpx;
  top: 30rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--accent2);
}

/* 半圆：橙（点元素，撞色锚点） */
.hd-semi {
  position: absolute;
  right: 138rpx;
  top: 186rpx;
  width: 96rpx;
  height: 48rpx;
  border-radius: 96rpx 96rpx 0 0;
  background: var(--accent3);
}

/* 点阵：3×3 米白圆点（数据点群） */
.hd-dots {
  position: absolute;
  right: 48rpx;
  top: 234rpx;
  width: 86rpx;
  height: 60rpx;
  background-image: radial-gradient(rgba(241, 230, 216, 0.8) 3rpx, transparent 4rpx);
  background-size: 30rpx 30rpx;
}

/* 外轨：慢旋虚线大圆（轨道动效） */
.hd-arc {
  position: absolute;
  right: 196rpx;
  top: -38rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 1rpx dashed rgba(241, 230, 216, 0.45);
  background: transparent;
  animation: hud-spin 26s linear infinite;
}

@keyframes hud-spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

/* 数据条组：三根竖条（信号强度计：米白 / 红 / 橙） */
.hd-sky {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 320rpx;
  height: 60rpx;
  background-image:
    linear-gradient(rgba(241, 230, 216, 0.3), rgba(241, 230, 216, 0.3)),
    linear-gradient(var(--accent2), var(--accent2)),
    linear-gradient(var(--accent3), var(--accent3));
  background-size: 3rpx 46rpx, 3rpx 60rpx, 3rpx 30rpx;
  background-position: 296rpx bottom, 306rpx bottom, 316rpx bottom;
  background-repeat: no-repeat;
}

/* 坐标标注：等宽小字（HUD 注释，位于主色块上，用米白） */
.hd-no {
  position: absolute;
  right: 26rpx;
  bottom: 14rpx;
  font-family: "DIN Alternate", "Consolas", "Menlo", monospace;
  font-size: 18rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  color: rgba(241, 230, 216, 0.65);
}

/* ============================================================
 * 二、布局容器
 * ============================================================ */
.page-wrap {
  padding-bottom: 60rpx;
}

/* ---------------- 顶部横幅（主色大块，双端大面积切换） ---------------- */
.hero {
  position: relative;
  overflow: hidden;
  padding: 46rpx 36rpx 60rpx;
  background: linear-gradient(118deg, var(--primary-soft) 0%, var(--primary) 46%, var(--primary-deep) 100%);
}

/* 扫描线：米白细光带周期性纵扫 */
.hero::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -20%;
  height: 14rpx;
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(241, 230, 216, 0.06) 40%,
    rgba(241, 230, 216, 0.22) 50%,
    rgba(241, 230, 216, 0.06) 60%,
    transparent 100%
  );
  animation: hud-scan 6.5s ease-in-out infinite;
  pointer-events: none;
}

@keyframes hud-scan {
  0%   { transform: translateY(0); opacity: 0; }
  12%  { opacity: 1; }
  55%  { transform: translateY(560rpx); opacity: 1; }
  70%  { opacity: 0; }
  100% { transform: translateY(560rpx); opacity: 0; }
}

.hero-title,
.hero-desc,
.hero-chip,
.hero-rule {
  position: relative;
  z-index: 2;
}

@keyframes hud-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

/* 标题下短线组：橙条 + 米白发丝 + 红点 */
.hero-rule {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.hero-rule .rule-a {
  width: 78rpx;
  height: 6rpx;
  background: var(--accent3);
}

.hero-rule .rule-b {
  width: 30rpx;
  height: 2rpx;
  margin-left: 10rpx;
  background: rgba(241, 230, 216, 0.6);
}

.hero-rule .rule-c {
  width: 12rpx;
  height: 12rpx;
  margin-left: 10rpx;
  border-radius: 50%;
  background: var(--accent2);
}

.hero-desc {
  margin-top: 18rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 0.5rpx;
}

.hero-chip {
  display: inline-block;
  margin-top: 26rpx;
  margin-right: 14rpx;
  padding: 8rpx 20rpx;
  background: rgba(241, 230, 216, 0.14);
  font-family: "DIN Alternate", "Consolas", "Menlo", monospace;
  font-size: 22rpx;
  color: #F1E6D8;
  letter-spacing: 1rpx;
}

/* ============================================================
 * 三、块面组件（白面板 + 藏蓝发丝边 + 对角括弧角标）
 * ============================================================ */
.card {
  position: relative;
  background: var(--paper);
  border: 1rpx solid rgba(40, 49, 78, 0.14);
  border-radius: var(--r-block);
  padding: 32rpx 30rpx;
  margin: 24rpx;
}

/* 左上橙 / 右下红：HUD 角标括弧 */
.card::before,
.card::after {
  content: '';
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  pointer-events: none;
}

.card::before {
  left: -1rpx;
  top: -1rpx;
  border-left: 4rpx solid var(--accent3);
  border-top: 4rpx solid var(--accent3);
}

.card::after {
  right: -1rpx;
  bottom: -1rpx;
  border-right: 4rpx solid var(--accent2);
  border-bottom: 4rpx solid var(--accent2);
}

/* 区块标题：橙色小方块引导 */
.sec-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 42rpx 26rpx 10rpx;
  font-size: 31rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.sec-title::before {
  content: '';
  width: 16rpx;
  height: 16rpx;
  margin-right: 14rpx;
  background: var(--accent3);
  flex-shrink: 0;
}

.sec-title .sec-sub {
  font-size: 22rpx;
  font-weight: 400;
  color: #97919A;
  letter-spacing: 0;
}

/* ============================================================
 * 四、按钮（实色块，无圆角）
 * ============================================================ */
.btn-primary {
  margin: 36rpx 26rpx 0;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: var(--r-block);
  background: var(--primary);
  color: #FFFFFF;
  font-size: 31rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 24rpx rgba(var(--primary-rgb), 0.28);
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  background: var(--primary-deep);
}

.btn-primary[disabled] {
  background: var(--primary-tint);
  color: #9AA0B4;
  box-shadow: none;
}

.btn-ghost {
  margin: 22rpx 26rpx 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--r-block);
  background: var(--paper);
  border: 1rpx solid rgba(40, 49, 78, 0.28);
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 700;
}

.btn-ghost::after {
  border: none;
}

.btn-mini {
  display: inline-block;
  padding: 0 26rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: var(--r-block);
  background: var(--primary);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.btn-mini::after {
  border: none;
}

.btn-mini.plain {
  background: transparent;
  border: 1rpx solid var(--primary);
  color: var(--primary);
}

/* ============================================================
 * 五、标签 / 头像（实色块 + 描边环）
 * ============================================================ */
.tag {
  display: inline-block;
  padding: 5rpx 16rpx;
  margin-right: 12rpx;
  border-radius: var(--r-block);
  background: var(--primary);
  color: #FFFFFF;
  font-size: 21rpx;
  font-weight: 600;
}

.tag.warm {
  background: var(--accent2);
  color: #FFFFFF;
}

/* 「已解决」：独立语义色，面积极小 */
.tag.green {
  background: #DFF1E8;
  color: #1E7A54;
}

.tag.grey {
  background: #ECEDEF;
  color: #7A8095;
}

.tag.orange {
  background: var(--accent3);
  color: #FFFFFF;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 0 0 3rpx rgba(40, 49, 78, 0.18);
}

.avatar.small {
  width: 66rpx;
  height: 66rpx;
  font-size: 26rpx;
}

/* 头像统一藏蓝：新生端看学长不再一片红，红只留给主题色块与强调 */
.avatar.warm {
  background: #28314E;
}

/* ============================================================
 * 六、列表项（白面板 + 藏蓝发丝边）
 * ============================================================ */
.list-item {
  position: relative;
  background: var(--paper);
  border: 1rpx solid rgba(40, 49, 78, 0.14);
  border-radius: var(--r-block);
  padding: 28rpx;
  margin: 18rpx 24rpx;
}

.list-head {
  display: flex;
  align-items: center;
}

.list-head .head-main {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.list-name {
  display: flex;
  align-items: center;
  font-size: 29rpx;
  font-weight: 700;
  color: var(--ink);
}

.list-time {
  font-size: 22rpx;
  color: #97919A;
}

.list-body {
  margin-top: 18rpx;
  font-size: 27rpx;
  color: #3A4152;
  word-break: break-all;
}

.list-foot {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.action-arrow {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--accent3);
  line-height: 1;
}

/* ============================================================
 * 七、空状态（准星圆环 + 十字线，藏蓝线画在米白上）
 * ============================================================ */
.empty {
  margin: 56rpx 48rpx;
  text-align: center;
}

.empty-icon {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 26rpx;
  border-radius: 50%;
  background: transparent;
  border: 2rpx solid rgba(40, 49, 78, 0.4);
}

/* 圆心：橙色实点 */
.empty-icon::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 20rpx;
  margin: -10rpx 0 0 -10rpx;
  background: var(--accent3);
  border-radius: 50%;
}

/* 十字准星线：横线穿圆而过 */
.empty-icon::before {
  content: '';
  position: absolute;
  left: -16rpx;
  top: 50%;
  width: 172rpx;
  height: 2rpx;
  margin-top: -1rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(40, 49, 78, 0.45) 18%,
    rgba(40, 49, 78, 0.45) 82%,
    transparent 100%
  );
}

.empty-text {
  font-size: 26rpx;
  color: #8A8494;
  letter-spacing: 0.5rpx;
}

/* ============================================================
 * 八、提示条 / 页脚
 * ============================================================ */
.notice {
  position: relative;
  margin: 26rpx 24rpx 0;
  padding: 24rpx 26rpx 24rpx 30rpx;
  border-left: 8rpx solid var(--accent3);
  background: var(--accent3-tint);
  font-size: 23rpx;
  color: #B05F14;
  line-height: 1.7;
}

.footer-tip {
  margin: 42rpx 40rpx 0;
  text-align: center;
  font-size: 21rpx;
  color: #97919A;
  line-height: 1.7;
  letter-spacing: 0.5rpx;
}

/* ============================================================
 * 九、未读角标 / 自有标识
 * ============================================================ */
.unread-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 9rpx;
  margin-left: 12rpx;
  border-radius: var(--r-block);
  background: var(--accent2);
  color: #FFFFFF;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
  flex-shrink: 0;
}

.own-ask-tag {
  margin-left: 10rpx;
  padding: 3rpx 12rpx;
  border-radius: var(--r-block);
  background: var(--accent3);
  color: #FFFFFF;
  font-size: 19rpx;
  line-height: 30rpx;
  flex-shrink: 0;
}

/* ============================================================
 * 十、在线咨询入口
 * ============================================================ */
.help-entry {
  position: relative;
  display: flex;
  align-items: center;
  margin: 24rpx;
  padding: 28rpx;
  background: var(--paper);
  border: 1rpx solid rgba(40, 49, 78, 0.14);
  border-radius: var(--r-block);
  overflow: hidden;
}

.help-entry:active {
  background: var(--accent1-soft);
}

.help-badge {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
  background: var(--primary);
}

.help-badge::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: var(--accent3);
}

.help-badge::after {
  content: '';
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 20rpx solid rgba(241, 230, 216, 0.9);
}

.help-entry-main {
  flex: 1;
  margin-left: 22rpx;
  min-width: 0;
}

.help-entry-title {
  font-size: 31rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.help-entry-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8A8494;
}

.help-entry-strip {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.help-entry-strip .st-a,
.help-entry-strip .st-b,
.help-entry-strip .st-c {
  width: 12rpx;
  height: 12rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  background: var(--primary);
}

.help-entry-strip .st-b {
  background: var(--accent3);
}

.help-entry-strip .st-c {
  background: var(--accent2);
}

/* ============================================================
 * 十一、顶部分区条（米白底 + 橙色指示条）
 * ============================================================ */
.top-tabs {
  display: flex;
  align-items: stretch;
  background: var(--accent1-soft);
  border-bottom: 1rpx solid rgba(40, 49, 78, 0.14);
  padding: 0 24rpx;
  height: 88rpx;
}

.top-tab {
  position: relative;
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  color: rgba(40, 49, 78, 0.45);
  letter-spacing: 2rpx;
}

.top-tab.on {
  color: var(--ink);
  font-size: 31rpx;
  font-weight: 800;
}

.top-tab.on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  background: var(--accent3);
}

/* ============================================================
 * 十二、HUD 通用元件（米白区用藏蓝线；hero 主色块上覆写为米白线）
 * ============================================================ */

/* 等宽注释小字：米白区默认藏蓝 */
.hud-label {
  font-family: "DIN Alternate", "Consolas", "Menlo", monospace;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: rgba(40, 49, 78, 0.55);
  text-transform: uppercase;
}

/* hero 主色块内：覆写为米白（index/mine 的标注挂在 hero-deco 里） */
.hero .hud-label {
  color: rgba(241, 230, 216, 0.6);
}

/* 十字准星：+ 形（米白区藏蓝线） */
.hud-cross {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  pointer-events: none;
}

.hud-cross::before,
.hud-cross::after {
  content: '';
  position: absolute;
  background: rgba(40, 49, 78, 0.55);
}

.hud-cross::before {
  left: 0;
  top: 50%;
  width: 100%;
  height: 2rpx;
  margin-top: -1rpx;
}

.hud-cross::after {
  left: 50%;
  top: 0;
  width: 2rpx;
  height: 100%;
  margin-left: -1rpx;
}

.hero .hud-cross::before,
.hero .hud-cross::after {
  background: rgba(241, 230, 216, 0.6);
}

/* 藏蓝细描边小方块 */
.hud-cell {
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid rgba(40, 49, 78, 0.6);
}

/* 红 / 橙撞色小实块 */
.hud-blip-red {
  width: 14rpx;
  height: 14rpx;
  background: var(--accent2);
}

.hud-blip-orange {
  width: 14rpx;
  height: 14rpx;
  background: var(--accent3);
}
